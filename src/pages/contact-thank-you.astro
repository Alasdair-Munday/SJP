---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Message sent"
  description="Thanks for contacting St John's Park. We will get back to you soon."
>
  <div class="utility-shell page-stack">
    <section class="content-band" data-tone="stone">
      <p class="eyebrow">Thank you</p>
      <h1 class="display-title">Message sent</h1>
      <p class="lede">
        Thanks for getting in touch. We will get back to you as soon as we can.
      </p>
      <div class="button-row">
        <a class="button-link" href="/">Return home</a>
        <a class="button-link--secondary" href="/visit">Plan a visit</a>
      </div>
    </section>
  </div>
</BaseLayout>
