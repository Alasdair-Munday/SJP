---
import { getCollection } from "astro:content";
import CampaignPage from "../../components/templates/CampaignPage.astro";
export async function getStaticPaths() {
  return (await getCollection("campaigns")).map(entry => ({ params: { slug: entry.id }, props: { campaign: entry.data } }));
}
const { campaign } = Astro.props;
---
<CampaignPage campaign={campaign} />
