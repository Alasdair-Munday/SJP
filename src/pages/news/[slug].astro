---
import { getTargetSchedule, formatDay, timeLabel } from "../../lib/events";
import BaseLayout from "../../layouts/BaseLayout.astro";
import MaskedImage from "../../components/sections/MaskedImage.astro";
import { getAllPosts, withoutImageMask } from "../../lib/content";
import { formatDate, formatShortDate } from "../../lib/format";

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const post = (await getAllPosts()).find((item) => item.slug === Astro.params.slug);
if (!post) return new Response('Not found', { status: 404 });
const sessions = await getTargetSchedule(`/news/${post.slug}`);
const { Content } = await post.render();

const categoryLabels = {
  event: "Event",
  update: "Update",
  blog: "Blog",
};
const nextSession = sessions.events[0];
const eventDateText = nextSession ? formatDay(nextSession.start) : post.data.eventDate ? formatDate(post.data.eventDate) : undefined;
const detailItems = [
  post.data.category === "event"
    ? { label: "Date", value: eventDateText }
    : { label: "Posted", value: formatShortDate(post.data.publishDate) },
  { label: "Time", value: nextSession ? timeLabel(nextSession) : post.data.timeText },
  { label: "Location", value: nextSession ? nextSession.location : post.data.location },
].filter((item) => item.value);
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  image={post.data.socialImage?.src ?? post.data.featuredImage.src}
  imageAlt={post.data.socialImage?.alt ?? post.data.featuredImage.alt}
  type="article"
  publishedTime={post.data.publishDate}
>
  <div class="utility-shell page-stack post-detail-shell">
    <article class="content-band post-detail-article" data-tone="stone">
      <div class="post-detail__header">
        <div class="post-detail__intro">
          <a class="inline-link post-detail__back" href="/news">News</a>
          <p class="eyebrow">{categoryLabels[post.data.category]}</p>
          <h1 class="display-title post-detail__title">{post.data.title}</h1>
          <p class="lede post-detail__lede">{post.data.summary}</p>
        </div>

        <MaskedImage
          image={withoutImageMask(post.data.featuredImage)}
          class="post-detail__media"
          priority
        />
      </div>

      <div class="post-detail__body-grid">
        <div class="post-detail__content">
          <Content />
          {sessions.events.length > 0 && <section class="upcoming-dates">
            <h2>Upcoming dates</h2>
            {sessions.message && <p class="calendar-status">{sessions.message}</p>}
            <ul>{sessions.events.map((event) => <li>{formatDay(event.start)} · {timeLabel(event)}{event.location && ` · ${event.location}`}</li>)}</ul>
          </section>}
        </div>

        <aside class="post-detail__aside" aria-label="News post details">
          <h2 class="post-detail__aside-title">Details</h2>
          <dl class="post-detail__details-list">
            {
              detailItems.map((item) => (
                <>
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </>
              ))
            }
          </dl>
          <div class="button-row post-detail__actions">
            {
              post.data.ctaHref && post.data.ctaLabel && (
                <a class="button-link" href={post.data.ctaHref}>{post.data.ctaLabel}</a>
              )
            }
            <a class="button-link--secondary" href="/news">Back to news</a>
          </div>
        </aside>
      </div>
    </article>
  </div>
</BaseLayout>
