---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MaskedImage from "../../components/sections/MaskedImage.astro";
import { getAllPosts, type PostEntry } from "../../lib/content";
import { formatDate, formatShortDate } from "../../lib/format";

export async function getStaticPaths() {
  const posts = await getAllPosts();

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const { Content } = await post.render();

const categoryLabels = {
  event: "Event",
  update: "Update",
  blog: "Blog",
};
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <div class="utility-shell page-stack">
    <article class="content-band" data-tone="stone">
      <p class="eyebrow">{categoryLabels[post.data.category]}</p>
      <h1 class="display-title">{post.data.title}</h1>
      <div class="post-detail__meta">
        <span>{formatShortDate(post.data.publishDate)}</span>
        {post.data.eventDate && <span>{formatDate(post.data.eventDate)}</span>}
        {post.data.timeText && <span>{post.data.timeText}</span>}
        {post.data.location && <span>{post.data.location}</span>}
      </div>
      <p class="lede">{post.data.summary}</p>
      <MaskedImage image={post.data.featuredImage} />
      <div class="post-detail__content">
        <Content />
      </div>
      <div class="button-row">
        {
          post.data.ctaHref && post.data.ctaLabel && (
            <a class="button-link" href={post.data.ctaHref}>{post.data.ctaLabel}</a>
          )
        }
        <a class="button-link--secondary" href="/news">Back to news</a>
      </div>
    </article>
  </div>
</BaseLayout>
