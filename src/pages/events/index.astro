---
import FeedCards from "../../components/templates/FeedCards.astro";
import SectionRenderer from "../../components/sections/SectionRenderer.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllEvents, getPageContent, getUpcomingEventPosts } from "../../lib/content";
import { formatDate } from "../../lib/format";
import { getSchedule, formatDay, timeLabel } from "../../lib/events";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store");
const events = await getAllEvents();
const page = await getPageContent("events");
const now = new Date();
const until = new Date(now);
until.setMonth(until.getMonth() + 6);
const schedule = await getSchedule(now, until);
const entries = events.map((eventPage) => ({
  eventPage,
  schedule: { ...schedule, events: schedule.events.filter((event) => event.href === `/events/${eventPage.slug}`).slice(0, 1) },
}));
const eventPageRoutes = new Set(events.map((eventPage) => `/events/${eventPage.slug}`));
const announcements = await getUpcomingEventPosts();
const announcementRoutes = new Set(announcements.map(post => `/news/${post.slug}`));
const upcomingEvents = schedule.events.filter(event => !eventPageRoutes.has(event.href ?? "") && !announcementRoutes.has(event.href ?? ""));
const upcoming = [
  ...announcements.map(post => {
    const session = schedule.events.find(event => event.href === `/news/${post.slug}`);
    return { date: session?.start ?? post.data.eventDate!, label: "Event", category: "event", dateLabel: session ? formatDay(session.start) : [formatDate(post.data.eventDate!), post.data.eventEndDate && +post.data.eventEndDate > +post.data.eventDate! ? formatDate(post.data.eventEndDate) : undefined].filter(Boolean).join(" – "), time: session ? timeLabel(session) : post.data.timeText, image: post.data.featuredImage, title: post.data.title, summary: post.data.summary, location: session?.location ?? post.data.location, href: `/news/${post.slug}` };
  }),
  ...upcomingEvents.map(event => ({ date: event.start, label: "Event", category: "event", dateLabel: formatDay(event.start), time: timeLabel(event), image: undefined, title: event.title, summary: undefined, location: event.location, href: event.href })),
].sort((a,b) => +new Date(a.date) - +new Date(b.date));
const bySlug = new Map(entries.map((entry) => [entry.eventPage.slug, entry]));
const featuredEntries = page.featuredEvents.flatMap(({ event }) => {
  const entry = bySlug.get(event);
  return entry ? [entry] : [];
});
const featuredSet = new Set(featuredEntries.map((entry) => entry.eventPage.slug));
const remainingEntries = entries.filter((entry) => !featuredSet.has(entry.eventPage.slug)).sort((left, right) => {
  const leftNext = left.schedule.events[0]?.start;
  const rightNext = right.schedule.events[0]?.start;
  if (leftNext && rightNext) return new Date(leftNext).getTime() - new Date(rightNext).getTime() || left.eventPage.data.title.localeCompare(right.eventPage.data.title);
  if (leftNext) return -1;
  if (rightNext) return 1;
  return left.eventPage.data.title.localeCompare(right.eventPage.data.title);
});
const orderedEntries = [...featuredEntries, ...remainingEntries];
---

<BaseLayout title={page.title} description={page.metaDescription}>
  <div class="page-stack">
    {page.sections.length ? <SectionRenderer sections={page.sections} /> : <HeroSection section={{
      type: "hero", title: page.title, eyebrow: page.eyebrow, body: page.intro ?? "Find out what’s coming up at St John’s Park.",
      backgroundTone: "pink", image: { src: "/images/uploads/Family-bustle.jpg", alt: "Church family and neighbours smiling together outdoors", maskShape: "/images/shapes/arch-shape-filled.png", accentShape: "/images/shapes/firework.png", objectPosition: "center center", frameTone: "sky" },
    }} />}
    <section class="content-band news-feed-band" data-tone="stone" aria-labelledby="upcoming-events-title">
      <div class="news-feed__header">
        <div class="news-feed__intro">
          <p class="eyebrow">Dates for your diary</p>
          <h2 class="section-title" id="upcoming-events-title">Upcoming events</h2>
        </div>
        <a class="inline-link" href="/news">Looking for updates? Read the news</a>
      </div>
      {schedule.message && <p class="calendar-status" role="status">{schedule.message}</p>}
      {upcoming.length ? <FeedCards cards={upcoming.map(event => ({ ...event, date: event.dateLabel }))} readMore="Find out more" /> : <p>No upcoming events listed yet.</p>}
    </section>
    <section class="content-band news-feed-band" data-tone="stone" aria-labelledby="regular-activities-title">
      <div class="news-feed__header"><div class="news-feed__intro">
        <p class="eyebrow">Life together</p>
        <h2 class="section-title" id="regular-activities-title">Regular activities</h2>
      </div></div>
      <FeedCards cards={orderedEntries.map(({ eventPage, schedule }) => ({
        title: eventPage.data.title, summary: eventPage.data.summary, category: "event", label: "Regular activity",
        date: schedule.events[0] ? formatDay(schedule.events[0].start) : undefined,
        time: schedule.events[0] ? timeLabel(schedule.events[0]) : eventPage.data.timeText || "Dates to follow",
        location: schedule.events[0]?.location || eventPage.data.location,
        image: eventPage.data.image, href: `/events/${eventPage.slug}`,
      }))} readMore="Find out more" />
    </section>
  </div>
</BaseLayout>
