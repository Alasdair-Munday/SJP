---
export const prerender = false;
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=300");
import BaseLayout from "../layouts/BaseLayout.astro";
import TalkListingTemplate from "../components/templates/TalkListingTemplate.astro";
import { getPageContent } from "../lib/content";

const page = await getPageContent("talks");
---

<BaseLayout title={page.title} description={page.metaDescription}>
  <TalkListingTemplate page={page} />
</BaseLayout>
