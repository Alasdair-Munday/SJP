---
import Layout from "../layouts/Layout.astro";
import CalendarEvents from "../components/CalendarEvents.astro";
import FeaturedEvent from "../components/FeaturedEvent.astro";
import NewsUpdates from "../components/NewsUpdates.astro";
import { getSiteContent } from "../data/site-content";
import {
	ArrowRight,
	Users,
	Zap,
	Heart,
	MapPin,
	Calendar,
	Coffee,
	Smile,
	PlayCircle,
} from "lucide-react";

const content = await getSiteContent();
const { hero, mission_grid, latest_message, coming_up, mission } =
	content.pages.home;
const visit = content.pages.visit;
const heroPostcardLabel = hero.badge ?? "Welcome Home";

const latest_message_details = content.sermons[0];

type FirstTimeLegacyCard = { title: string; body?: string; body_html?: string };
type FirstTimeLegacy = {
	heading?: string;
	intro?: string;
	cards?: FirstTimeLegacyCard[];
};

const firstTimeLegacy = (content.pages.home as { first_time?: FirstTimeLegacy })
	.first_time;

const firstTimeHeading =
	visit.home_preview?.heading ??
	firstTimeLegacy?.heading ??
	"First Time Visiting?";
const firstTimeIntro =
	visit.home_preview?.intro ?? firstTimeLegacy?.intro ?? "";
const firstTimeCards = (
	visit.sections?.map((section) => ({
		title: section.heading,
		body_html: section.paragraphs.join(" "),
	})) ??
	firstTimeLegacy?.cards?.map((card) => ({
		title: card.title,
		body_html: card.body_html ?? card.body ?? "",
	})) ??
	[]
).slice(0, 3);
const firstTimePhoto = visit.gallery?.[0] ?? {
	src: "/images/refreshments.jpg",
	alt: "People chatting over refreshments after a Sunday gathering",
};
const missionPhoto = content.pages.church_life.groups?.[0]?.image ?? {
	src: "/images/congregation.jpg",
	alt: "Church family gathered together in worship",
};
const latestMessagePhoto = content.pages.talks.hero_image ?? {
	src: "/images/Sermons.jpg",
	alt: "Bible talk being shared during a Sunday service",
};
const comingUpPhoto = content.pages.calendar.sunday_gathering?.image ?? {
	src: "/images/worship team.jpg",
	alt: "Worship team leading on a Sunday morning",
};
---

<Layout title="Home">
	<!-- HERO SECTION -->
	<section
		class="section-band section-band--green has-doodly-stars has-doodly-stars--leaf is-doodly-visible"
	>
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20">
			<div class="grid lg:grid-cols-[1.04fr_0.96fr] gap-12 items-center">
				<div>
					<h1
						class="theme-display-font text-5xl md:text-7xl font-bold tracking-tight leading-[0.95] mb-6"
					>
						{hero.title}
					</h1>
					<p
						class="text-xl md:text-2xl font-medium max-w-2xl leading-relaxed mb-10 border-l-4 border-(--gold) pl-6"
						set:html={hero.subtitle}
					/>
					<div class="flex flex-wrap gap-4">
						<a
							href={hero.primary_cta.href}
							class="hero-primary-cta group px-8 py-4 bg-(--gold) text-(--ink) font-bold tracking-wide rounded-lg hover:bg-white transition-all duration-300 flex items-center gap-3 transform hover:-translate-y-1"
						>
							{hero.primary_cta.label}
							<ArrowRight
								size={20}
								className="group-hover:translate-x-1 transition-transform"
							/>
						</a>
						<a
							href={hero.secondary_cta.href}
							class="group px-8 py-4 bg-white/14 text-(--band-on-light) font-semibold tracking-wide border border-white/45 rounded-lg hover:bg-white/85 transition-all duration-300 flex items-center gap-3 shadow-md hover:shadow-lg transform hover:-translate-y-1"
						>
							{hero.secondary_cta.label}
							<MapPin
								size={20}
								className="group-hover:scale-110 transition-transform"
							/>
						</a>
					</div>
				</div>
				<div
					class="relative max-w-[540px] w-full mx-auto lg:mx-0 lg:justify-self-end"
				>
					<div class="hero-postcard">
						<img
							src={hero.image.src}
							alt={hero.image.alt}
							class="w-full h-[420px] md:h-[500px] object-cover"
						/>
						<span class="hero-postcard-note"
							>{heroPostcardLabel}</span
						>
					</div>
				</div>
			</div>
		</div>
		<div class="section-doodlystars" aria-hidden="true">
			<span class="section-doodlystar section-doodlystar--top-left"
			></span>
			<span
				class="section-doodlystar section-doodlystar--right-edge section-doodlystar--delay"
			></span>
		</div>
		<div
			class="section-wave"
			aria-hidden="true"
			style="--wave-next: var(--section-blue);"
		>
			<svg viewBox="0 0 1440 120" preserveAspectRatio="none">
				<path
					d="M0,26 C120,78 280,78 420,42 C560,6 700,6 840,42 C980,78 1120,78 1260,42 C1348,20 1408,18 1440,24 L1440,120 L0,120 Z"
				></path>
			</svg>
		</div>
	</section>

	<!-- I'M NEW: VISITOR BRIDGE -->
	<section class="section-band section-band--blue section-band--blue-bright">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="mb-10">
				<h2 class="page-heading text-4xl font-bold">
					{firstTimeHeading}
				</h2>
				<p class="text-(--ink)/85 font-medium mt-3 max-w-3xl">
					{firstTimeIntro}
				</p>
			</div>
			<figure class="theme-card overflow-hidden mb-8 max-w-4xl">
				<img
					src={firstTimePhoto.src}
					alt={firstTimePhoto.alt}
					class="w-full h-60 md:h-72 object-cover"
					loading="lazy"
				/>
			</figure>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				{
					firstTimeCards.map((card, index) => (
						<article class="home-strip-item pt-6">
							<div
								class:list={[
									"w-12 h-12 rounded-full text-(--ink) flex items-center justify-center mb-4",
									index % 3 === 0 && "bg-white/18",
									index % 3 === 1 && "bg-white/24",
									index % 3 === 2 && "bg-white/14",
								]}
							>
								{index % 3 === 0 ? (
									<Coffee size={22} />
								) : index % 3 === 1 ? (
									<Smile size={22} />
								) : (
									<MapPin size={22} />
								)}
							</div>
							<h3 class="section-heading text-2xl mb-2">
								{card.title}
							</h3>
							<p
								class="text-(--ink)/90"
								set:html={card.body_html}
							/>
						</article>
					))
				}
			</div>
			<div class="mt-8">
				<a
					href="/visit"
					class="inline-flex items-center gap-2 px-5 py-2.5 border-2 border-(--ink) text-(--ink) font-semibold hover:bg-white/90 hover:text-[#10232e] transition-colors"
				>
					See Full I'm New Guide <ArrowRight size={18} />
				</a>
			</div>
		</div>
		<div
			class="section-wave"
			aria-hidden="true"
			style="--wave-next: var(--section-mauve);"
		>
			<svg viewBox="0 0 1440 120" preserveAspectRatio="none">
				<path
					d="M0,26 C120,78 280,78 420,42 C560,6 700,6 840,42 C980,78 1120,78 1260,42 C1348,20 1408,18 1440,24 L1440,120 L0,120 Z"
				></path>
			</svg>
		</div>
	</section>
	<!-- MISSION GRID -->
	<section class="section-band section-band--mauve">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div
				class="flex items-end gap-4 mb-12 border-b-2 border-(--ink) pb-4"
			>
				<h2 class="page-heading text-4xl font-bold tracking-tight">
					{mission.heading}
				</h2>
				<span
					class="mb-2 font-mono text-sm text-(--ink)/60 hidden md:inline-block"
					>{mission.tag}</span
				>
			</div>
			<figure class="theme-card overflow-hidden mb-8 max-w-5xl">
				<img
					src={missionPhoto.src}
					alt={missionPhoto.alt}
					class="w-full h-60 md:h-72 object-cover"
					loading="lazy"
				/>
			</figure>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div class="home-strip-item pt-6 group">
					<div
						class="w-12 h-12 bg-white/16 text-(--ink) flex items-center justify-center mb-6 group-hover:bg-white/24 transition-colors rounded-full"
					>
						<Users size={24} />
					</div>
					<h3 class="text-2xl font-bold mb-3 text-(--ink)">
						{mission_grid[0].title}
					</h3>
					<p class="text-(--ink)/80 font-medium mb-8 leading-relaxed">
						{mission_grid[0].desc}
					</p>
					<a
						href={mission_grid[0].link_href}
						class="inline-flex items-center gap-2 font-semibold text-sm tracking-wide border-b-2 border-(--ink) pb-1 hover:text-(--eden) hover:border-(--eden) transition-colors"
					>
						{mission_grid[0].link_text}
						<ArrowRight size={16} />
					</a>
				</div>

				<div class="home-strip-item pt-6 group">
					<div
						class="w-12 h-12 bg-white/16 text-(--ink) flex items-center justify-center mb-6 group-hover:bg-white/24 transition-colors rounded-full"
					>
						<Zap size={24} />
					</div>
					<h3 class="text-2xl font-bold mb-3 text-(--ink)">
						{mission_grid[1].title}
					</h3>
					<p class="text-(--ink)/80 font-medium mb-8 leading-relaxed">
						{mission_grid[1].desc}
					</p>
					<a
						href={mission_grid[1].link_href}
						class="inline-flex items-center gap-2 font-semibold text-sm tracking-wide border-b-2 border-(--ink) pb-1 hover:text-(--teal) hover:border-(--teal) transition-colors"
					>
						{mission_grid[1].link_text}
						<ArrowRight size={16} />
					</a>
				</div>

				<div class="home-strip-item pt-6 group">
					<div
						class="w-12 h-12 bg-white/16 text-(--ink) flex items-center justify-center mb-6 rounded-full"
					>
						<Heart size={24} />
					</div>
					<h3 class="text-2xl font-bold mb-3 text-(--ink)">
						{mission_grid[2].title}
					</h3>
					<p class="text-(--ink) font-bold mb-8 leading-relaxed">
						{mission_grid[2].desc}
					</p>
					<a
						href={mission_grid[2].link_href}
						class="inline-flex items-center gap-2 font-semibold text-sm tracking-wide border-b-2 border-(--ink) pb-1 text-(--ink) hover:text-(--gold) hover:border-(--gold) transition-colors"
					>
						{mission_grid[2].link_text}
						<ArrowRight size={16} />
					</a>
				</div>
			</div>

		</div>
		<div
			class="section-wave"
			aria-hidden="true"
			style="--wave-next: var(--section-plum);"
		>
			<svg viewBox="0 0 1440 120" preserveAspectRatio="none">
				<path
					d="M0,26 C120,78 280,78 420,42 C560,6 700,6 840,42 C980,78 1120,78 1260,42 C1348,20 1408,18 1440,24 L1440,120 L0,120 Z"
				></path>
			</svg>
		</div>
	</section>
	<!-- LATEST MESSAGE -->
	<section
		class="section-band section-band--plum has-doodly-stars has-doodly-stars--sky is-doodly-visible"
	>
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="band-split-block py-10">
				<div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-8 items-start">
					<div>
						<p
							class="text-sm uppercase tracking-[0.14em] font-bold text-(--teal) mb-3"
						>
							{latest_message.eyebrow}
						</p>
						<h2 class="page-heading text-4xl font-bold mb-4">
							{latest_message_details.title}
						</h2>
						<p class="text-(--ink)/85 text-lg font-medium">
							{latest_message_details.description}
						</p>
						<div class="space-y-4 mt-8">
							<audio controls class="w-full">
								<source
									src={latest_message_details.audioUrl}
									type="audio/mpeg"
								/>
								Your browser does not support the audio player.
							</audio>
							<a
								href={latest_message.cta.href}
								class="inline-flex items-center gap-2 px-5 py-2.5 border-2 border-(--ink) text-(--ink) font-semibold hover:bg-white/90 hover:text-[#10232e] transition-colors"
							>
								{latest_message.cta.label}
								<PlayCircle size={18} />
							</a>
						</div>
					</div>
					<figure class="theme-card overflow-hidden">
						<img
							src={latestMessagePhoto.src}
							alt={latestMessagePhoto.alt}
							class="w-full h-64 md:h-80 object-cover"
							loading="lazy"
						/>
					</figure>
				</div>
			</div>
		</div>
		<div class="section-doodlystars" aria-hidden="true">
			<span class="section-doodlystar section-doodlystar--left-edge"
			></span>
			<span
				class="section-doodlystar section-doodlystar--bottom-right section-doodlystar--delay-2"
			></span>
		</div>
		<div
			class="section-wave"
			aria-hidden="true"
			style="--wave-next: var(--section-blue);"
		>
			<svg viewBox="0 0 1440 120" preserveAspectRatio="none">
				<path
					d="M0,26 C120,78 280,78 420,42 C560,6 700,6 840,42 C980,78 1120,78 1260,42 C1348,20 1408,18 1440,24 L1440,120 L0,120 Z"
				></path>
			</svg>
		</div>
	</section>

	<NewsUpdates />

	<!-- BANNER: Upcoming -->
	<section class="section-band section-band--green pb-20">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
			<div class="flex items-center gap-3 mb-8">
				<Calendar className="w-8 h-8 text-(--ink)" />
				<h2
					class="page-heading text-4xl font-bold tracking-tight text-(--ink)"
				>
					{coming_up.title}
				</h2>
			</div>
			<figure class="theme-card overflow-hidden max-w-5xl">
				<img
					src={comingUpPhoto.src}
					alt={comingUpPhoto.alt}
					class="w-full h-60 md:h-72 object-cover"
					loading="lazy"
				/>
			</figure>

			<FeaturedEvent />
			<CalendarEvents />
		</div>
	</section>
</Layout>
