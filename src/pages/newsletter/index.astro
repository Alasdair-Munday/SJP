---
import { parseIssueDate } from "../../lib/events";
import WeeklySchedule from "../../components/sections/WeeklySchedule.astro";
import { getNewsletterData } from "../../lib/newsletter";
import "../../styles/print.css";

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
let issueDate: Date;
try { issueDate = parseIssueDate(Astro.url.searchParams.get('date')); }
catch { return new Response('Please choose a valid issue date (YYYY-MM-DD).', { status: 400 }); }
const newsletter = await getNewsletterData(issueDate);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Weekly Newsletter - {newsletter.formattedDate}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Karla:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="newsletter-body newsletter-body--print">
    <div class="newsletter-container">
      <header class="newsletter-header">
        <div class="newsletter-brand">
          <img src={newsletter.logoSrc} alt={newsletter.logoAlt} />
          <div>
            <p class="newsletter-kicker">Weekly newsletter</p>
            <h1>News & Updates</h1>
            <p class="newsletter-date">{newsletter.formattedDate}</p>
          </div>
        </div>
        <nav class="newsletter-actions" aria-label="Newsletter actions">
          <a href={`/newsletter/email/?date=${newsletter.issueDate}`}>Email export</a>
          <a href={`/newsletter/social/?date=${newsletter.issueDate}`}>Social media</a>
          <button onclick="window.print()" class="print-button">Print Newsletter</button>
        </nav>
      </header>

      <form class="newsletter-date-picker" method="get">
        <label for="issue-date">Issue date</label>
        <input id="issue-date" type="date" name="date" value={newsletter.issueDate} required />
        <button type="submit">Update newsletter</button>
      </form>
      <main class="newsletter-content">
        <section class="newsletter-schedule" aria-labelledby="this-week-title">
          <h2 id="this-week-title">This week</h2>
          <p>{newsletter.schedule.label}</p>
          <WeeklySchedule schedule={newsletter.schedule} start={newsletter.schedule.start} end={newsletter.schedule.end} />
        </section>
        {
          newsletter.posts.length > 0 ? (
            newsletter.posts.map((post) => {
              return (
                <article class="newsletter-post">
                  <img
                    class="newsletter-post__image"
                    src={post.imageSrc}
                    alt={post.imageAlt}
                  />
                  <div class="newsletter-post__content">
                    <p class="newsletter-post__category">{post.category}</p>
                    <h2>{post.title}</h2>
                    {post.eventDetails && (
                      <p class="newsletter-meta">
                        {post.eventDetails}
                      </p>
                    )}
                    <p>{post.summary}</p>
                    <a class="newsletter-cta" href={post.ctaHref}>{post.ctaLabel}</a>
                  </div>
                </article>
              );
            })
          ) : (
            <p>No news for this week.</p>
          )
        }
      </main>

      <footer class="newsletter-footer">
        <p>{newsletter.shortTitle} · {newsletter.sundaySummary}</p>
        {(newsletter.facebookUrl || newsletter.instagramUrl) && <p>
          {newsletter.facebookUrl && <a href={newsletter.facebookUrl}>Facebook</a>}
          {newsletter.facebookUrl && newsletter.instagramUrl && " · "}
          {newsletter.instagramUrl && <a href={newsletter.instagramUrl}>Instagram</a>}
        </p>}
      </footer>
    </div>
  </body>
</html>
