---
import { getNewsletterData } from "../../lib/newsletter";
import "../../styles/print.css";

const newsletter = await getNewsletterData();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Weekly Newsletter - {newsletter.formattedDate}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Karla:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="newsletter-body newsletter-body--print">
    <div class="newsletter-container">
      <header class="newsletter-header">
        <div class="newsletter-brand">
          <img src={newsletter.logoSrc} alt={newsletter.logoAlt} />
          <div>
            <p class="newsletter-kicker">Weekly newsletter</p>
            <h1>News & Updates</h1>
            <p class="newsletter-date">{newsletter.formattedDate}</p>
          </div>
        </div>
        <nav class="newsletter-actions" aria-label="Newsletter actions">
          <a href="/newsletter/email/">Email export</a>
          <button onclick="window.print()" class="print-button">Print Newsletter</button>
        </nav>
      </header>

      <main class="newsletter-content">
        {
          newsletter.posts.length > 0 ? (
            newsletter.posts.map((post) => {
              return (
                <article class="newsletter-post">
                  <img
                    class="newsletter-post__image"
                    src={post.imageSrc}
                    alt={post.imageAlt}
                  />
                  <div class="newsletter-post__content">
                    <p class="newsletter-post__category">{post.category}</p>
                    <h2>{post.title}</h2>
                    {post.eventDetails && (
                      <p class="newsletter-meta">
                        {post.eventDetails}
                      </p>
                    )}
                    <p>{post.summary}</p>
                    <a class="newsletter-cta" href={post.ctaHref}>{post.ctaLabel}</a>
                  </div>
                </article>
              );
            })
          ) : (
            <p>No news for this week.</p>
          )
        }
      </main>

      <footer class="newsletter-footer">
        <p>{newsletter.shortTitle} · {newsletter.sundaySummary}</p>
      </footer>
    </div>
  </body>
</html>
