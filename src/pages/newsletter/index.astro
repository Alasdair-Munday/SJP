---
import QRCode from "qrcode";
import { parseNewsletterDate, formatDay, timeLabel } from "../../lib/events";
import WeeklySchedule from "../../components/sections/WeeklySchedule.astro";
import { getNewsletterData, applyNewsletterSelection } from "../../lib/newsletter";
import "../../styles/print.css";

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
let issueDate: Date;
try { issueDate = parseNewsletterDate(Astro.url.searchParams.get('date')); }
catch { return new Response('Please choose a valid issue date (YYYY-MM-DD).', { status: 400 }); }
const candidates = await getNewsletterData(issueDate);
const newsletter = applyNewsletterSelection(candidates, Astro.url.searchParams);
const selectedPosts = new Set(newsletter.posts.map(post => post.id));
const selectedEvents = new Set(newsletter.schedule.events.map(event => event.id));
const downloadHref = (edition: string) => {
  const query = new URL(newsletter.onlineUrl).searchParams;
  query.set("edition", edition);
  return `/newsletter/pdf/?${query}`;
};
const qrCodes = await Promise.all(newsletter.posts.map((post) => QRCode.toDataURL(post.url, {
  errorCorrectionLevel: "M", margin: 4, width: 384, color: { dark: "#000000", light: "#ffffff" },
})));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Weekly Newsletter - {newsletter.formattedDate}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Karla:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="newsletter-body newsletter-body--print">
    <div class="newsletter-container">
      <header class="newsletter-header">
        <div class="newsletter-brand">
          <img src={newsletter.logoSrc} alt={newsletter.logoAlt} />
          <div>
            <p class="newsletter-kicker">Weekly newsletter</p>
            <h1>News & Updates</h1>
            <p class="newsletter-date">{newsletter.formattedDate}</p>
          </div>
        </div>
        <nav class="newsletter-actions" aria-label="Newsletter actions">
          <span>Download newsletter:</span>
          <a href={downloadHref("print")}>Print version auto</a>
          <a href={downloadHref("print-full-page")}>Print version full page</a>
          <a href={downloadHref("print-booklet")}>Print version booklet</a>
          <a href={downloadHref("digital")}>Digital</a>
        </nav>
      </header>

      <form class="newsletter-date-picker" method="get">
        <label for="issue-date">Week starting Monday</label>
        <input id="issue-date" type="date" name="date" value={newsletter.issueDate} min="1970-01-05" step="7" aria-describedby="issue-date-help" required />
        <button type="submit">Update newsletter</button>
        <span id="issue-date-help">Choose a Monday.</span>
      </form>
      <form class="newsletter-selection" method="get">
        <input type="hidden" name="date" value={newsletter.issueDate} />
        <input type="hidden" name="selection" value="custom" />
        <h2>Choose what to include</h2>
        <p>Untick any items you want to leave out, then apply your selection before downloading. This does not change published content.</p>
        <details open>
          <summary>News and event announcements ({selectedPosts.size} selected)</summary>
          {candidates.posts.map(post => <label><input type="checkbox" name="post" value={post.id} checked={selectedPosts.has(post.id)} /> {post.title}</label>)}
        </details>
        <details>
          <summary>Weekly timetable ({selectedEvents.size} selected)</summary>
          {candidates.schedule.events.map(event => <label><input type="checkbox" name="event" value={event.id} checked={selectedEvents.has(event.id)} /> {formatDay(event.start)} · {timeLabel(event)} · {event.title}</label>)}
        </details>
        <button type="submit">Apply selection</button>
        <a href={`/newsletter/?date=${newsletter.issueDate}`}>Reset selection</a>
      </form>
      <main class="newsletter-content">
        <section class="newsletter-schedule" aria-labelledby="this-week-title">
          <h2 id="this-week-title">This week</h2>
          <p>{newsletter.schedule.label}</p>
          <WeeklySchedule schedule={newsletter.schedule} start={newsletter.schedule.start} end={newsletter.schedule.end} />
        </section>
        {
          newsletter.posts.length > 0 ? (
            newsletter.posts.map((post, index) => {
              return (
                <article class="newsletter-post">
                  <img
                    class="newsletter-post__image"
                    src={post.imageSrc}
                    alt={post.imageAlt}
                    width="144"
                    height="108"
                  />
                  <div class="newsletter-post__content">
                    <p class="newsletter-post__category">{post.category}</p>
                    <h2>{post.title}</h2>
                    {post.eventDetails && (
                      <p class="newsletter-meta">
                        {post.eventDetails}
                      </p>
                    )}
                    <p>{post.summary}</p>
                    <a class="newsletter-story-link" href={post.url}>
                      <img class="newsletter-qr" src={qrCodes[index]} width="128" height="128" alt={`QR code for the full story: ${post.title}`} />
                      <span>Scan to read the full story</span>
                    </a>
                  </div>
                </article>
              );
            })
          ) : (
            <p>No news for this week.</p>
          )
        }
      </main>

      <footer class="newsletter-footer">
        <p>{newsletter.shortTitle} · {newsletter.sundaySummary}</p>
        {(newsletter.facebookUrl || newsletter.instagramUrl) && <p>
          {newsletter.facebookUrl && <a href={newsletter.facebookUrl}>Facebook</a>}
          {newsletter.facebookUrl && newsletter.instagramUrl && " · "}
          {newsletter.instagramUrl && <a href={newsletter.instagramUrl}>Instagram</a>}
        </p>}
      </footer>
    </div>
  </body>
</html>
