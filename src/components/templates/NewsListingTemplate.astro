---
import type { CollectionEntry } from "astro:content";
import SectionRenderer from "../sections/SectionRenderer.astro";
import MaskedImage from "../sections/MaskedImage.astro";
import { formatShortDate } from "../../lib/format";
import { getNewsPosts, withoutImageMask } from "../../lib/content";

type PageData = CollectionEntry<"pages">["data"];

interface Props {
  page: PageData;
}

const { page } = Astro.props;
const posts = await getNewsPosts();

const categoryLabels = {
  update: "Updates",
  blog: "Blog",
  thought: "Thought for the week",
};
---

<div class="page-stack">
  <SectionRenderer sections={page.sections} />

  <section class="content-band news-feed-band" data-tone="stone">
    <div class="news-feed__header">
      <div class="news-feed__intro">
        <p class="eyebrow">Church news</p>
        <h2 class="section-title">From the life of St John's Park</h2>
      </div>

      <a class="inline-link" href="/events/">See upcoming events</a>
    </div>

    {posts.length === 0 && <p>No news has been published yet.</p>}
    <div class="news-grid">
      {
        posts.map((post, index) => (
          <article
            class="news-card news-card--feed"
            data-category={post.data.category}
            data-featured={index === 0 ? "true" : undefined}
          >
            <a class="news-card__image-link" href={`/news/${post.slug}`} aria-label={post.data.title}>
              <MaskedImage
                image={withoutImageMask(post.data.featuredImage)}
                class="news-card__media news-card__media--article"
              />
            </a>
            <div class="news-card__body">
              <div class="news-card__meta news-card__meta--primary">
                <span class="meta-chip">{post.data.category === "event" ? "Event" : categoryLabels[post.data.category]}</span>
                {post.data.author && <span>By {post.data.author}</span>}
                <span>{formatShortDate(post.data.publishDate)}</span>
              </div>
              <h2 class="post-title">
                <a class="news-card__link" href={`/news/${post.slug}`}>{post.data.title}</a>
              </h2>
              <p class="news-card__summary">{post.data.summary}</p>
              <a class="inline-link news-card__readmore" href={`/news/${post.slug}`}>Read more</a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</div>
