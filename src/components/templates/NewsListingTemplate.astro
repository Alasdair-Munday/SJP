---
import type { CollectionEntry } from "astro:content";
import SectionRenderer from "../sections/SectionRenderer.astro";
import FeedCards from "./FeedCards.astro";
import { formatShortDate } from "../../lib/format";
import { getNewsPosts } from "../../lib/content";

type PageData = CollectionEntry<"pages">["data"];

interface Props {
  page: PageData;
}

const { page } = Astro.props;
const posts = await getNewsPosts();

const categoryLabels = {
  event: "Events",
  update: "Updates",
  blog: "Blog",
  thought: "Thought for the week",
};
---

<div class="page-stack">
  <SectionRenderer sections={page.sections} />

  <section class="content-band news-feed-band" data-tone="stone">
    <div class="news-feed__header">
      <div class="news-feed__intro">
        <p class="eyebrow">Stories and updates</p>
        <h2 class="section-title">From the life of St John's Park</h2>
      </div>

      <a class="inline-link" href="/events">Looking for events? See what’s on</a>
    </div>

    {posts.length === 0 && <p>No news articles yet.</p>}
    <FeedCards cards={posts.map(post => ({
      title: post.data.title, summary: post.data.summary, category: post.data.category,
      label: categoryLabels[post.data.category], date: formatShortDate(post.data.publishDate),
      author: post.data.author, image: post.data.featuredImage, href: `/news/${post.slug}`,
    }))} />
  </section>
</div>

