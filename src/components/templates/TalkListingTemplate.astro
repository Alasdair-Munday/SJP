---
import type { CollectionEntry } from "astro:content";
import SectionRenderer from "../sections/SectionRenderer.astro";
import { formatDate, formatTalkDuration } from "../../lib/format";
import { getTalks } from "../../lib/talks";
import { getSiteConfig } from "../../lib/content";

type PageData = CollectionEntry<"pages">["data"];

interface Props {
  page: PageData;
}

const { page } = Astro.props;
const talks = await getTalks();
const site = await getSiteConfig();
---

<div class="page-stack">
  <SectionRenderer sections={page.sections} />

  <section id="talks-list" class="content-band" data-tone="stone">
    <p class="eyebrow">Sunday talks</p>
    <h2 class="section-title">Recent Talks</h2>
    <div class="talk-archive">
      {
        talks.map((talk) => (
          <article class="talk-row">
            <div class="talk-row__meta">
              <span class="meta-chip">{talk.series}</span>
              <span>{talk.speaker}</span>
              <span>{formatDate(talk.date)}</span>
              {talk.duration > 0 && <span>{formatTalkDuration(talk.duration)}</span>}
            </div>
            <h3 class="card-title">{talk.title}</h3>
            <p>{talk.description}</p>
            {talk.audioUrl && (
              <div class="talk-player-wrapper">
                <audio controls src={talk.audioUrl} class="talk-player"></audio>
              </div>
            )}
          </article>
        ))
      }
    </div>
    <div class="button-row">
      <a class="button-link--ghost" href={site.talks.spotifyHref} target="_blank" rel="noopener noreferrer">
        {site.talks.spotifyLabel}
      </a>
      <a class="icon-link" href={site.talks.rssHref} aria-label={site.talks.rssLabel} title={site.talks.rssLabel} target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rss"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
      </a>
    </div>
  </section>
</div>
