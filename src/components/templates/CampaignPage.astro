---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionRenderer from "../sections/SectionRenderer.astro";
import type { CollectionEntry } from "astro:content";
const { campaign } = Astro.props as { campaign: CollectionEntry<"campaigns">["data"] };
---
<BaseLayout title={campaign.title} description={campaign.metaDescription}>
  <div class="page-stack campaign-page"><SectionRenderer sections={campaign.sections} /></div>
</BaseLayout>
