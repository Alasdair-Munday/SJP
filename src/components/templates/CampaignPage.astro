---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionRenderer from "../sections/SectionRenderer.astro";
import type { CollectionEntry } from "astro:content";
const { campaign, campaignSlug } = Astro.props as { campaign: CollectionEntry<"campaigns">["data"]; campaignSlug: string };
const sections = campaign.sections.map(section =>
  section.type === "campaignPosts" ? { ...section, tag: campaignSlug } : section,
);
---
<BaseLayout title={campaign.title} description={campaign.metaDescription}>
  <div class="page-stack campaign-page"><SectionRenderer sections={sections} /></div>
</BaseLayout>
