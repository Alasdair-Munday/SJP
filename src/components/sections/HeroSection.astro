---
import type { CollectionEntry } from "astro:content";
import MaskedImage from "./MaskedImage.astro";

type PageSection = CollectionEntry<"pages">["data"]["sections"][number];

interface Props {
  section: Extract<PageSection, { type: "hero" }>;
}

const { section } = Astro.props;
const emphasizedWords = new Set(section.bodyEmphasis?.map((word) => word.toLowerCase()));
const bodyParts = section.body.split(/(\b\w+\b)/);
---

<section id={section.id} class="content-band" data-tone={section.backgroundTone}>
  <div class="hero-grid">
    <div class="hero-copy">
      {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
      <h1 class:list={["display-title", { "hero-title-art": section.titleImage }]}>
        {section.titleImage ? (
          <img
            src={section.titleImage.src}
            alt={section.title}
            width={section.titleImage.width}
            height={section.titleImage.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        ) : section.title}
      </h1>
      <p class="lede">
        {bodyParts.map((part) => emphasizedWords.has(part.toLowerCase()) ? <strong>{part}</strong> : part)}
      </p>
      <div class="button-row">
        {
          section.primaryCta && (
            <a class="button-link" href={section.primaryCta.href} target={section.primaryCta.newTab ? "_blank" : undefined} rel={section.primaryCta.newTab ? "noreferrer" : undefined}>
              {section.primaryCta.label}
            </a>
          )
        }
        {
          section.secondaryCta && (
            <a class="button-link--secondary" href={section.secondaryCta.href} target={section.secondaryCta.newTab ? "_blank" : undefined} rel={section.secondaryCta.newTab ? "noreferrer" : undefined}>
              {section.secondaryCta.label}
            </a>
          )
        }
      </div>
    </div>
    {section.image && <MaskedImage image={section.image} priority />}
  </div>
</section>
