---
import { getCollection, type CollectionEntry } from "astro:content";
import { hasCampaign, isUpcomingEventPost, sortPosts } from "../../lib/content";
import SplitSection from "./SplitSection.astro";
import { formatDate } from "../../lib/format";

type Section = Extract<CollectionEntry<"pages">["data"]["sections"][number], { type: "campaignPosts" }>;
const { section } = Astro.props as { section: Section };
const accentShapes = [
  "/images/shapes/star-brushstroke.png",
  "/images/shapes/circle-brushstroke-medium.png",
  "/images/shapes/flower-outline.png",
  "/images/shapes/heart-outline.png",
];
const posts = sortPosts((await getCollection("posts")).filter((post) =>
  hasCampaign(post, section.tag) &&
  (post.data.category !== "event" || isUpcomingEventPost(post)),
));
const groups = [
  { title: "Upcoming events", posts: posts.filter((post) => post.data.category === "event") },
  { title: "Latest news", posts: posts.filter((post) => post.data.category !== "event") },
];
---
<div id={section.id}>
  {groups.filter((group) => group.posts.length).map((group) => (
    <section aria-label={group.title}>
      <div class="content-band"><h2 class="section-title">{group.title}</h2></div>
      {group.posts.map((post, index) => (
        <SplitSection section={{
          type: "split",
          title: post.data.title,
          body: post.data.summary,
          points: [
            post.data.category === "event" && post.data.eventDate ? formatDate(post.data.eventDate) : "",
            post.data.timeText ?? "",
            post.data.location ?? "",
          ].filter(Boolean),
          backgroundTone: section.backgroundTones[index % section.backgroundTones.length],
          image: { ...post.data.featuredImage, accentShape: post.data.featuredImage.accentShape || accentShapes[index % accentShapes.length] },
          reverse: index % 2 === 1,
          ctas: [{ label: post.data.category === "event" ? "View event" : "Read more", href: `/news/${post.slug}`, newTab: false }],
        }} />
      ))}
    </section>
  ))}
</div>
