---
import type { CollectionEntry } from "astro:content";
import SplitSection from "./SplitSection.astro";
import { formatDate } from "../../lib/format";
import { getPublishedPosts, getAllEvents, isEventPost, isUpcomingEventPost } from "../../lib/content";
import { getSchedule, formatDay, timeLabel } from "../../lib/events";

type Section = Extract<CollectionEntry<"pages">["data"]["sections"][number], { type: "campaignPosts" }>;
const { section } = Astro.props as { section: Section };
const tag = section.tag?.trim().toLowerCase();
const matches = (tags: string[]) => !!tag && tags.some(value => value.trim().toLowerCase() === tag);
const accentShapes = ["/images/shapes/star-brushstroke.png", "/images/shapes/circle-brushstroke-medium.png", "/images/shapes/flower-outline.png", "/images/shapes/heart-outline.png"];
const [posts, regular] = await Promise.all([getPublishedPosts(), getAllEvents()]);
const now = new Date();
const until = new Date(now);
until.setMonth(until.getMonth() + 6);
const matchingPosts = posts.filter(post => matches(post.data.campaignTags));
const matchingRegular = regular.filter(event => matches(event.data.campaignTags));
const schedule = matchingRegular.length || matchingPosts.some(isEventPost) ? await getSchedule(now, until) : undefined;
const next = (href: string) => schedule?.events.find(event => event.href === href);
const eventItems = [
  ...matchingPosts.filter(isEventPost).flatMap(post => {
    const href = `/news/${post.slug}`;
    const session = next(href);
    if (!session && !isUpcomingEventPost(post)) return [];
    return [{ title: post.data.title, body: post.data.summary, image: post.data.featuredImage, href,
      date: session ? +new Date(session.start) : +(post.data.eventDate ?? now),
      points: [session ? formatDay(session.start) : post.data.eventDate ? (post.data.eventEndDate && +post.data.eventEndDate > +post.data.eventDate ? `${formatDate(post.data.eventDate)} – ${formatDate(post.data.eventEndDate)}` : formatDate(post.data.eventDate)) : "", session ? timeLabel(session) : post.data.timeText, session?.location ?? post.data.location].filter((value): value is string => Boolean(value)) }];
  }),
  ...matchingRegular.map(event => {
    const href = `/events/${event.slug}`;
    const session = next(href);
    return { title: event.data.title, body: event.data.summary, image: event.data.image, href,
      date: session ? +new Date(session.start) : Number.MAX_SAFE_INTEGER,
      points: [session ? formatDay(session.start) : "", session ? timeLabel(session) : event.data.timeText, session?.location ?? event.data.location].filter((value): value is string => Boolean(value)) };
  }),
].sort((a,b) => a.date - b.date);
const newsItems = matchingPosts.filter(post => !isEventPost(post)).map(post => ({ title: post.data.title, body: post.data.summary, image: post.data.featuredImage, href: `/news/${post.slug}`, points: [formatDate(post.data.publishDate)] }));
const undatedItems = matchingPosts.filter(post => isEventPost(post) && !post.data.eventDate && !next(`/news/${post.slug}`)).map(post => ({ title: post.data.title, body: post.data.summary, image: post.data.featuredImage, href: `/news/${post.slug}`, points: [post.data.timeText || "Date to be confirmed", post.data.location].filter((value): value is string => Boolean(value)) }));
const groups = [{ title: "Upcoming events", items: eventItems }, { title: "Dates to be confirmed", items: undatedItems }, { title: "Latest news", items: newsItems }];
---
{groups.filter(group => group.items.length).map(group => (
  <>
    <section class="content-band" data-tone="stone"><h2 class="section-title">{group.title}</h2></section>
    {group.items.map((item, index) => (
      <SplitSection section={{
        type: "split",
        id: index === 0 && group === groups.find(candidate => candidate.items.length) ? section.id : undefined,
        title: item.title,
        body: item.body,
        points: item.points,
        backgroundTone: section.backgroundTones[index % section.backgroundTones.length],
        image: item.image ? { ...item.image, accentShape: item.image.accentShape || accentShapes[index % accentShapes.length] } : undefined,
        reverse: index % 2 === 1,
        ctas: [{ label: "Find out more", href: item.href, newTab: false }],
      }} />
    ))}
  </>
))}
