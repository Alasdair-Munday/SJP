---
import type { CollectionEntry } from "astro:content";
import MaskedImage from "./MaskedImage.astro";

type PageSection = CollectionEntry<"pages">["data"]["sections"][number];

interface Props {
  section: Extract<PageSection, { type: "cards" }>;
}

const { section } = Astro.props;
---

<section id={section.id} class="content-band" data-tone={section.backgroundTone}>
  {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
  <h2 class="section-title">{section.title}</h2>
  {section.intro && <p class="lede">{section.intro}</p>}
  <div class="cards-grid" data-columns={section.columns}>
    {
      section.cards.map((card) => (
        <article class="info-card" data-card-tone={card.tone} data-has-image={Boolean(card.image)}>
          {card.image && <MaskedImage image={card.image} class="news-card__media" />}
          <h3 class="card-title">{card.title}</h3>
          {card.tag && <span class="info-card__tag">{card.tag}</span>}
          {card.body && <p class="info-card__body">{card.body}</p>}
          {
            card.href && card.linkLabel && (
              <a class="inline-link" href={card.href}>
                {card.linkLabel}
              </a>
            )
          }
        </article>
      ))
    }
  </div>
</section>
