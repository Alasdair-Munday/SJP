---
import type { CollectionEntry } from "astro:content";
import HeroSection from "./HeroSection.astro";
import IntroSection from "./IntroSection.astro";
import SplitSection from "./SplitSection.astro";
import CardsSection from "./CardsSection.astro";
import CallToActionSection from "./CallToActionSection.astro";
import LatestSection from "./LatestSection.astro";
import RichTextSection from "./RichTextSection.astro";

type PageSection = CollectionEntry<"pages">["data"]["sections"][number];
type SectionComponent = (_props: { section: PageSection }) => unknown;

interface Props {
  sections: PageSection[];
}

const { sections } = Astro.props as Props;

const sectionComponents = {
  hero: HeroSection as SectionComponent,
  intro: IntroSection as SectionComponent,
  split: SplitSection as SectionComponent,
  cards: CardsSection as SectionComponent,
  cta: CallToActionSection as SectionComponent,
  latest: LatestSection as SectionComponent,
  richText: RichTextSection as SectionComponent,
} satisfies Record<PageSection["type"], SectionComponent>;
---

{
  sections.map((section) => {
    const SectionComponent = sectionComponents[section.type];
    return <SectionComponent section={section} />;
  })
}
