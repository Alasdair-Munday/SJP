---
import { compactSchedule, type Schedule } from '../../lib/events';
interface Props { schedule: Schedule; start: Date; end: Date; }
const { schedule } = Astro.props;
const entries = compactSchedule(schedule.events);
---
{schedule.message && <p class="calendar-status" role="status">{schedule.message}</p>}
{entries.length ? <div class="weekly-schedule">
  <ul>{entries.map((entry) => <li class="weekly-schedule__event">
    {entry.events.map((event) => <i class="calendar-occurrence-id" aria-hidden="true" data-calendar-id={event.id}></i>)}
    <span class="weekly-schedule__when">{entry.dayLabel} · {entry.timeLabel}</span>
    <div>{entry.first.href ? <a href={entry.first.href}>{entry.first.title}</a> : <strong>{entry.first.title}</strong>}
    {entry.first.location && <span class="weekly-schedule__location">{entry.first.location}</span>}</div>
  </li>)}</ul>
</div> : schedule.status !== 'unavailable' && <p>No events are listed for these seven days.</p>}
