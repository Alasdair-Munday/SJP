---
import type { CollectionEntry } from "astro:content";
import { getNetlifyOptimizedImageUrl, isLocalRasterImage } from "../../lib/images";

type PageSection = CollectionEntry<"pages">["data"]["sections"][number];
type SectionImage = Extract<PageSection, { image?: unknown }>["image"];

interface Props {
  image: NonNullable<SectionImage>;
  class?: string;
  priority?: boolean;
}

const { image, class: className, priority = false } = Astro.props;
const standardImageWidths = [320, 480, 640, 960, 1280, 1440] as const;
const priorityImageWidths = [320, 480, 640, 960, 1280, 1600] as const;
const imageWidths = priority ? priorityImageWidths : standardImageWidths;
const imageQuality = 76;
const isNewsCardMedia = className?.includes("news-card__media");
const isPostDetailMedia = className?.includes("post-detail__media");

const getOptimizedImageUrl = (src: string, width: number, height: number) =>
  getNetlifyOptimizedImageUrl({ src, width, height, quality: imageQuality });
const getOptimizedSrcset = (src: string, heightRatio: number) =>
  imageWidths
    .map((width) => `${getOptimizedImageUrl(src, width, Math.round(width * heightRatio))} ${width}w`)
    .join(", ");

const imageSizes = isNewsCardMedia
  ? "(max-width: 780px) 90vw, 24rem"
  : isPostDetailMedia
    ? "(max-width: 980px) 90vw, 54rem"
  : "(max-width: 980px) 90vw, 45vw";

const intrinsicDimensions = isNewsCardMedia
  ? { width: 1200, height: 1200 }
  : isPostDetailMedia
    ? { width: 1600, height: 1200 }
  : priority
    ? { width: 1600, height: 1720 }
    : { width: 1440, height: 1548 };
const heightRatio = intrinsicDimensions.height / intrinsicDimensions.width;
const galleryImages = [
  {
    src: image.src,
    alt: image.alt,
    objectPosition: image.objectPosition,
  },
  ...(image.gallery ?? []).map((galleryImage) => ({
    src: galleryImage.src,
    alt: galleryImage.alt ?? "",
    objectPosition: galleryImage.objectPosition ?? image.objectPosition,
  })),
];
const hasGallery = galleryImages.length > 1;
const maskShape = image.maskShape;
const maskName = maskShape?.split("/").pop()?.replace(/\.[^.]+$/, "");
const accentCorners = ["top-right", "bottom-left", "top-left", "bottom-right"] as const;
const accentCorner =
  accentCorners[
    [...image.src].reduce((total, character) => total + character.charCodeAt(0), 0) %
      accentCorners.length
  ];
const oppositeCorners = {
  "top-right": "bottom-left",
  "bottom-left": "top-right",
  "top-left": "bottom-right",
  "bottom-right": "top-left",
} as const;
const backdropShapes = [
  "/images/shapes/rectangle-cut-corner.png",
  "/images/shapes/church-hall-roof.png",
  "/images/shapes/square-slope-shape.png",
  "/images/shapes/three-columns-shape.png",
  "/images/shapes/church-hall-shape-2.png",
  "/images/shapes/church-windows-shape.png",
  "/images/shapes/curved-square-shape.png",
  "/images/shapes/rectangle-2.png",
  "/images/shapes/tall-church-window.png",
  "/images/shapes/triangle-shape.png",
  "/images/shapes/long-square-line.png",
  "/images/shapes/three-sticks-shape.png",
] as const;
const backdropShape =
  backdropShapes[
    [...image.src].reduce((total, character) => total + character.charCodeAt(0), 0) %
      backdropShapes.length
  ];
---

<div
  class:list={["masked-media", className]}
  data-frame-tone={image.frameTone ?? "stone"}
  data-accent-tone={image.accentTone}
  data-accent-corner={accentCorner}
  data-backdrop-corner={oppositeCorners[accentCorner]}
>
  <span
    class="masked-media__backdrop"
    style={`--backdrop-shape: url('${backdropShape}');`}
  ></span>
  <div
    class="masked-media__shape"
    data-gallery={hasGallery ? "true" : undefined}
    data-mask={maskName}
    style={maskShape ? `--mask-shape: url('${maskShape}');` : undefined}
  >
    {
      galleryImages.map((galleryImage, index) => {
        const isActiveSlide = index === 0;
        const sharedAttributes = {
          alt: isActiveSlide ? galleryImage.alt : "",
          "aria-hidden": isActiveSlide ? undefined : "true",
          "data-active": isActiveSlide ? "true" : undefined,
          style: galleryImage.objectPosition ? `object-position: ${galleryImage.objectPosition};` : undefined,
          loading: priority && isActiveSlide ? "eager" : "lazy",
          decoding: "async",
          fetchpriority: priority && isActiveSlide ? "high" : "low",
        } as const;

        if (isLocalRasterImage(galleryImage.src)) {
          if (!isActiveSlide && hasGallery) {
            return (
              <img
                {...sharedAttributes}
                data-src={getOptimizedImageUrl(
                  galleryImage.src,
                  intrinsicDimensions.width,
                  intrinsicDimensions.height,
                )}
                data-srcset={getOptimizedSrcset(galleryImage.src, heightRatio)}
                sizes={imageSizes}
                width={intrinsicDimensions.width}
                height={intrinsicDimensions.height}
              />
            );
          }

          return (
            <img
              src={getOptimizedImageUrl(
                galleryImage.src,
                intrinsicDimensions.width,
                intrinsicDimensions.height,
              )}
              srcset={getOptimizedSrcset(galleryImage.src, heightRatio)}
              sizes={imageSizes}
              width={intrinsicDimensions.width}
              height={intrinsicDimensions.height}
              {...sharedAttributes}
            />
          );
        }

        return (
          <img
            src={isActiveSlide ? galleryImage.src : undefined}
            data-src={!isActiveSlide ? galleryImage.src : undefined}
            width={intrinsicDimensions.width}
            height={intrinsicDimensions.height}
            {...sharedAttributes}
          />
        );
      })
    }
  </div>
  {
    image.accentShape && (
      <span
        class="masked-media__accent"
        style={`--accent-shape: url('${image.accentShape}');`}
      ></span>
    )
  }
  {
    image.wordArtShape && (
      <span
        class="masked-media__word"
        style={`--word-shape: url('${image.wordArtShape}');`}
      ></span>
    )
  }
</div>

{
  hasGallery && (
    <script>
      const galleryShapes = document.querySelectorAll<HTMLElement>(".masked-media__shape[data-gallery='true']");
      const connection = (navigator as Navigator & {
        connection?: { saveData?: boolean; effectiveType?: string };
      }).connection;
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const shouldKeepStatic =
        prefersReducedMotion ||
        connection?.saveData === true ||
        /(^|-)2g$/.test(connection?.effectiveType ?? "");

      const hydrateSlide = (slide: HTMLImageElement) => {
        if (slide.dataset.srcset && !slide.srcset) {
          slide.srcset = slide.dataset.srcset;
          slide.removeAttribute("data-srcset");
        }
        if (slide.dataset.src && !slide.currentSrc) {
          slide.src = slide.dataset.src;
          slide.removeAttribute("data-src");
        }
      };

      const prepareGallery = (shape: HTMLElement) => {
        if (shape.dataset.galleryReady === "true") return;
        shape.dataset.galleryReady = "true";

        const slides = Array.from(shape.querySelectorAll<HTMLImageElement>("img"));
        if (slides.length < 2) return;

        slides.slice(1).forEach(hydrateSlide);

        let activeIndex = 0;

        window.setInterval(() => {
          slides[activeIndex].removeAttribute("data-active");
          activeIndex = (activeIndex + 1) % slides.length;
          slides[activeIndex].dataset.active = "true";
        }, 1800);
      };

      if (!shouldKeepStatic) {
        if ("IntersectionObserver" in window) {
          const galleryObserver = new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                prepareGallery(entry.target as HTMLElement);
                observer.unobserve(entry.target);
              });
            },
            { rootMargin: "360px" },
          );

          galleryShapes.forEach((shape) => galleryObserver.observe(shape));
        } else {
          galleryShapes.forEach(prepareGallery);
        }
      }
    </script>
  )
}
