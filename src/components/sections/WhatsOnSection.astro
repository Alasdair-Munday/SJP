---
import type { CollectionEntry } from 'astro:content';
import { getThisWeek, compactSchedule, formatDay, timeLabel } from '../../lib/events';
interface Props { section: Extract<CollectionEntry<'pages'>['data']['sections'][number], { type: 'whatsOn' }>; }
const { section } = Astro.props;
const now = new Date();
const schedule = await getThisWeek(now);
const upcoming = schedule.events.filter((event) => new Date(event.end) > now || new Date(event.start) >= now);
const next = upcoming[0];
const entries = compactSchedule(upcoming.slice(1));
const happeningNow = next && new Date(next.start) <= now && new Date(next.end) > now;
---
<section id={section.id} class="content-band whats-on" data-tone={section.backgroundTone}>
  <div class="whats-on__header">
    <div><p class="eyebrow">Come and join us</p><h2 class="section-title">{section.title}</h2></div>
    <a class="inline-link" href="/events/">Explore our regular events →</a>
  </div>
  {schedule.message && <p class="calendar-status" role="status">{schedule.message}</p>}
  {next ? <div class="whats-on__layout">
    <article class="next-event">
      <i class="calendar-occurrence-id" aria-hidden="true" data-calendar-id={next.id}></i>
      <p class="eyebrow">{happeningNow ? 'Happening now' : 'Next up'}</p>
      <h3>{next.title}</h3>
      <p class="next-event__date"><time datetime={next.start}>{formatDay(next.start)}</time></p>
      <p class="next-event__time">{timeLabel(next)}</p>
      {next.location && <p class="next-event__location">{next.location}</p>}
      {next.href && <a class="next-event__link" href={next.href}>Find out more <span aria-hidden="true">→</span></a>}
    </article>
    <div class="upcoming-agenda">
      <h3>Coming up</h3><p class="upcoming-agenda__range">{schedule.label}</p>
      {entries.length ? <ul>{entries.map((entry) => <li class="upcoming-agenda__event">
        {entry.events.map((event) => <i class="calendar-occurrence-id" aria-hidden="true" data-calendar-id={event.id}></i>)}
        <div class="upcoming-agenda__when"><span>{entry.dayLabel}</span><span>{entry.timeLabel}</span></div>
        <div>{entry.first.href ? <a href={entry.first.href}>{entry.first.title}</a> : <strong>{entry.first.title}</strong>}
          {entry.first.location && <span class="upcoming-agenda__location">{entry.first.location}</span>}
        </div>
      </li>)}</ul> : <p>That’s the last event listed for the next seven days.</p>}
    </div>
  </div> : schedule.status !== 'unavailable' && <p>No upcoming events are listed for the next seven days.</p>}
</section>
