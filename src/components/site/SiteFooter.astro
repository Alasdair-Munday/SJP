---
import type { CollectionEntry } from "astro:content";

type SiteData = CollectionEntry<"site">["data"];

interface Props {
  site: SiteData;
}

const { site } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__band">
      <div class="site-footer__grid">
        <section>
          <h2 class="site-footer__title">{site.shortTitle}</h2>
          <p class="site-footer__meta">{site.footer.blurb}</p>
          <p class="site-footer__meta">{site.sundaySummary}</p>
          <p class="site-footer__meta">
            <a href={`mailto:${site.contact.email}`}>{site.footer.contactLabel}</a>
          </p>
          {(site.social.facebookUrl || site.social.instagramUrl) && (
            <ul class="site-footer__list site-footer__social" aria-label="Social media">
              {site.social.facebookUrl && <li><a href={site.social.facebookUrl} target="_blank" rel="noreferrer">Facebook</a></li>}
              {site.social.instagramUrl && <li><a href={site.social.instagramUrl} target="_blank" rel="noreferrer">Instagram</a></li>}
            </ul>
          )}
        </section>

        <section>
          <h2 class="site-footer__title">Explore</h2>
          <ul class="site-footer__list">
            {
              site.footer.quickLinks.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))
            }
          </ul>
        </section>

        <section>
          <h2 class="site-footer__title">Policies</h2>
          <ul class="site-footer__list">
            {
              site.footer.policyLinks.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>
  </div>
</footer>
