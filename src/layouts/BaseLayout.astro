---
import { getSiteConfig } from "../lib/content";
import SiteFooter from "../components/site/SiteFooter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  noIndex?: boolean;
}

const { title, description, image, imageAlt, type = "website", publishedTime, noIndex = false } = Astro.props;
const site = await getSiteConfig();
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const pageTitle = title === "Home" ? site.shortTitle : `${title} | ${site.shortTitle}`;
const pageDescription = description ?? site.metaDescription;
const canonicalUrl = new URL(currentPath === "/" ? "/" : currentPath, site.siteUrl).toString();
const socialImage = new URL(image ?? "/images/line-drawing.png", site.siteUrl).toString();
const socialImageAlt = imageAlt ?? site.brand.lockupAlt;
const analyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Karla:wght@400;500;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.setAttribute('media', 'all')"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Karla:wght@400;500;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <title>{pageTitle}</title>
    {analyticsToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analyticsToken })}></script>}
  </head>
  <body>
    <div class="site-frame">
      <SiteHeader site={site} currentPath={currentPath} />
      <main class="site-main">
        <div class="site-container">
          <slot />
        </div>
      </main>
      <SiteFooter site={site} />
    </div>
  </body>
</html>
