---
import Logo from "../components/Logo.astro";
import { ChevronDown, Menu, X } from "lucide-react";
import { getSiteContent } from "../data/site-content";
import "../styles/global.css";

interface Props {
  title: string;
}

type NavigationChild = { label: string; href: string };
type NavigationItem = {
  label: string;
  href: string;
  children?: NavigationChild[];
};

const { title } = Astro.props;
const content = await getSiteContent();
const footerLinks = content.footer.quick_links;
const navigationItems = (content.navigation ?? []) as NavigationItem[];
const brand = content.site.brand ?? {
  logo_line_one: "St John's Church",
  logo_line_two: "Park",
};
const footerHeading = content.footer.quick_links_heading ?? "Quick Links";
const footerBackgroundImage = content.footer.background_image ?? {
  src: "/images/line-drawing.png",
  alt: "",
};
const rawTheme = (import.meta.env.PUBLIC_SITE_THEME ?? "current").toLowerCase();
const themeAliases: Record<string, "current" | "garden-city" | "line-drawing"> =
  {
    current: "current",
    default: "current",
    "garden-city": "garden-city",
    gardencity: "garden-city",
    garden: "garden-city",
    "line-drawing": "line-drawing",
    linedrawing: "line-drawing",
    art: "line-drawing",
  };
const siteTheme = themeAliases[rawTheme] ?? "current";
---

<!doctype html>
<html lang="en" data-theme={siteTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={content.site.meta_description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Patrick+Hand&family=Nunito+Sans:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title} | {content.site.title}</title>
  </head>
  <body class="site-shell text-(--ink)">
    <!-- NAVIGATION -->
    <nav class="site-appbar sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="site-appbar-row flex justify-between h-20 items-center">
          <!-- LOGO -->
          <a href="/" class="site-brand shrink-0 flex items-center gap-4 group">
            <div
              class="w-12 h-12 rounded-full bg-(--eden) text-white border-2 border-(--ink)/15 shadow-[0_4px_10px_rgba(18,39,31,0.2)] flex items-center justify-center transition-colors group-hover:bg-(--section-blue)"
            >
              <Logo class="w-8 h-8" />
            </div>
            <div class="leading-none">
              <span
                class="block font-extrabold text-xl tracking-tight text-(--ink)"
                >{brand.logo_line_one}</span
              >
              <span
                class="block font-semibold text-xl tracking-wide text-(--eden) -mt-1"
                >{brand.logo_line_two}</span
              >
            </div>
          </a>

          <!-- DESKTOP MENU -->
          <div class="hidden md:flex items-center gap-1">
            {
              navigationItems.map((item, index) => {
                const hasChildren = Array.isArray(item.children) && item.children.length > 0;
                const panelId = `desktop-nav-panel-${index}`;
                return (
                  <div data-desktop-group class="nav-parent relative">
                    <div class="nav-parent-row inline-flex items-center">
                      <a
                        href={item.href}
                        class="site-nav-link text-(--ink) font-semibold text-sm tracking-wide px-3 py-2"
                      >
                        {item.label}
                      </a>
                      {
                        hasChildren && (
                          <button
                            type="button"
                            data-desktop-toggle
                            aria-expanded="false"
                            aria-controls={panelId}
                            class="site-nav-toggle inline-flex items-center justify-center h-9 w-9 text-(--ink)"
                          >
                            <span class="sr-only">Toggle {item.label} menu</span>
                            <ChevronDown className="nav-parent-chevron" size={16} />
                          </button>
                        )
                      }
                    </div>
                    {
                      hasChildren && (
                        <div
                          id={panelId}
                          data-desktop-panel
                          class="site-submenu hidden absolute left-0 top-full min-w-64 p-2 flex flex-col gap-1 z-50"
                        >
                          {
                            item.children?.map((child) => (
                              <a
                                href={child.href}
                                class="site-submenu-link text-(--ink) font-semibold text-sm tracking-wide px-3 py-2 transition-colors"
                              >
                                {child.label}
                              </a>
                            ))
                          }
                        </div>
                      )
                    }
                  </div>
                );
              })
            }
          </div>

          <!-- MOBILE MENU TOGGLE -->
          <button
            id="mobile-menu-toggle"
            type="button"
            class="site-mobile-toggle md:hidden inline-flex items-center justify-center w-12 h-12 text-(--ink) transition-colors"
            aria-expanded="false"
            aria-controls="mobile-menu-panel"
            aria-label="Toggle navigation menu"
          >
            <Menu data-menu-icon-open size={22} />
            <X data-menu-icon-close size={22} className="hidden" />
          </button>
        </div>
      </div>

      <div
        id="mobile-menu-panel"
        class="site-mobile-panel hidden md:hidden"
      >
        <div class="px-4 py-4 space-y-4">
          {
            navigationItems.map((item, index) => {
              const hasChildren = Array.isArray(item.children) && item.children.length > 0;
              const panelId = `mobile-nav-panel-${index}`;
              return (
                <section class="space-y-2">
                  <div class="flex items-center justify-between gap-2">
                    <a
                      data-mobile-link
                      href={item.href}
                      class="site-mobile-link text-(--ink) font-semibold text-base tracking-wide px-3 py-2 transition-colors grow"
                    >
                      {item.label}
                    </a>
                    {
                      hasChildren && (
                        <button
                          type="button"
                          data-mobile-submenu-toggle
                          aria-expanded="false"
                          aria-controls={panelId}
                          class="site-mobile-submenu-toggle inline-flex items-center justify-center w-10 h-10 text-(--ink)"
                        >
                          <span class="sr-only">Toggle {item.label} links</span>
                          <ChevronDown className="mobile-submenu-chevron" size={16} />
                        </button>
                      )
                    }
                  </div>
                  {
                    hasChildren && (
                      <div id={panelId} data-mobile-submenu-panel class="hidden pl-4">
                        <div class="flex flex-col gap-1">
                          {
                            item.children?.map((child) => (
                              <a
                                data-mobile-child-link
                                href={child.href}
                                class="site-mobile-child-link text-(--ink)/90 font-semibold text-sm tracking-wide px-3 py-2 transition-colors"
                              >
                                {child.label}
                              </a>
                            ))
                          }
                        </div>
                      </div>
                    )
                  }
                </section>
              );
            })
          }
          <a
            data-mobile-link
            href={brand.nav_cta_href}
            class="mt-2 bg-(--gold) text-(--ink) px-4 py-2.5 font-semibold text-sm tracking-wide border-2 border-(--ink) hover:bg-white transition-all inline-flex w-fit"
          >
            {brand.nav_cta_label}
          </a>
        </div>
      </div>
    </nav>

    <script is:inline>
      (() => {
        const toggle = document.getElementById("mobile-menu-toggle");
        const panel = document.getElementById("mobile-menu-panel");
        if (!toggle || !panel) return;

        const openIcon = toggle.querySelector("[data-menu-icon-open]");
        const closeIcon = toggle.querySelector("[data-menu-icon-close]");
        const links = panel.querySelectorAll("a[data-mobile-link], a[data-mobile-child-link]");

        const desktopGroups = Array.from(document.querySelectorAll("[data-desktop-group]"));
        const desktopCloseTimers = new WeakMap();
        const HOVER_CLOSE_DELAY = 190;

        const clearDesktopCloseTimer = (group) => {
          const timeoutId = desktopCloseTimers.get(group);
          if (timeoutId) {
            window.clearTimeout(timeoutId);
            desktopCloseTimers.delete(group);
          }
        };

        const closeDesktopGroups = () => {
          desktopGroups.forEach((group) => {
            clearDesktopCloseTimer(group);
            group.classList.remove("is-open");
            group.classList.remove("is-hover-open");
            const button = group.querySelector("button[data-desktop-toggle]");
            const submenu = group.querySelector("[data-desktop-panel]");
            if (button) button.setAttribute("aria-expanded", "false");
            if (submenu) submenu.classList.add("hidden");
          });
        };

        const openDesktopGroup = (group, pinned = false) => {
          desktopGroups.forEach((other) => {
            if (other === group) return;
            clearDesktopCloseTimer(other);
            other.classList.remove("is-open");
            other.classList.remove("is-hover-open");
            const otherButton = other.querySelector("button[data-desktop-toggle]");
            const otherSubmenu = other.querySelector("[data-desktop-panel]");
            if (otherButton) otherButton.setAttribute("aria-expanded", "false");
            if (otherSubmenu) otherSubmenu.classList.add("hidden");
          });
          clearDesktopCloseTimer(group);
          group.classList.toggle("is-open", pinned);
          group.classList.add("is-hover-open");
          const button = group.querySelector("button[data-desktop-toggle]");
          const submenu = group.querySelector("[data-desktop-panel]");
          if (button) button.setAttribute("aria-expanded", "true");
          if (submenu) submenu.classList.remove("hidden");
        };

        const scheduleDesktopGroupClose = (group) => {
          clearDesktopCloseTimer(group);
          const timeoutId = window.setTimeout(() => {
            if (group.classList.contains("is-open")) return;
            group.classList.remove("is-hover-open");
            const button = group.querySelector("button[data-desktop-toggle]");
            const submenu = group.querySelector("[data-desktop-panel]");
            if (button) button.setAttribute("aria-expanded", "false");
            if (submenu) submenu.classList.add("hidden");
          }, HOVER_CLOSE_DELAY);
          desktopCloseTimers.set(group, timeoutId);
        };

        desktopGroups.forEach((group) => {
          const button = group.querySelector("button[data-desktop-toggle]");
          if (!button) return;

          group.addEventListener("mouseenter", () => {
            openDesktopGroup(group);
          });

          group.addEventListener("mouseleave", () => {
            scheduleDesktopGroupClose(group);
          });

          button.addEventListener("click", (event) => {
            event.preventDefault();
            event.stopPropagation();
            const isOpen = group.classList.contains("is-open");
            if (isOpen) {
              closeDesktopGroups();
            } else {
              openDesktopGroup(group, true);
            }
          });

          button.addEventListener("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
              event.preventDefault();
              button.click();
            }
          });
        });

        const setOpen = (isOpen) => {
          toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
          panel.classList.toggle("hidden", !isOpen);
          openIcon?.classList.toggle("hidden", isOpen);
          closeIcon?.classList.toggle("hidden", !isOpen);
        };

        const closeMobileSubmenus = () => {
          const toggles = panel.querySelectorAll("button[data-mobile-submenu-toggle]");
          toggles.forEach((submenuToggle) => {
            const panelId = submenuToggle.getAttribute("aria-controls");
            if (!panelId) return;
            const submenu = document.getElementById(panelId);
            submenuToggle.setAttribute("aria-expanded", "false");
            submenu?.classList.add("hidden");
          });
        };

        setOpen(false);

        toggle.addEventListener("click", () => {
          const expanded = toggle.getAttribute("aria-expanded") === "true";
          setOpen(!expanded);
        });

        const mobileSubmenuToggles = panel.querySelectorAll("button[data-mobile-submenu-toggle]");
        mobileSubmenuToggles.forEach((submenuToggle) => {
          submenuToggle.addEventListener("click", () => {
            const panelId = submenuToggle.getAttribute("aria-controls");
            if (!panelId) return;
            const submenu = document.getElementById(panelId);
            if (!submenu) return;

            const isOpen = submenuToggle.getAttribute("aria-expanded") === "true";
            closeMobileSubmenus();
            if (!isOpen) {
              submenuToggle.setAttribute("aria-expanded", "true");
              submenu.classList.remove("hidden");
            }
          });
        });

        links.forEach((link) => {
          link.addEventListener("click", () => {
            setOpen(false);
            closeMobileSubmenus();
          });
        });

        document.addEventListener("click", (event) => {
          const target = event.target;
          if (!(target instanceof Node)) return;

          desktopGroups.forEach((group) => {
            if (!group.contains(target)) {
              clearDesktopCloseTimer(group);
              group.classList.remove("is-open");
              group.classList.remove("is-hover-open");
              const button = group.querySelector("button[data-desktop-toggle]");
              const submenu = group.querySelector("[data-desktop-panel]");
              if (button) button.setAttribute("aria-expanded", "false");
              if (submenu) submenu.classList.add("hidden");
            }
          });
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            setOpen(false);
            closeDesktopGroups();
            closeMobileSubmenus();
          }
        });

        window.addEventListener("resize", () => {
          if (window.innerWidth >= 768) {
            setOpen(false);
            closeDesktopGroups();
            closeMobileSubmenus();
          }
        });
      })();
    </script>

    <slot />

    <!-- FOOTER -->
    <footer
      class="themed-footer py-16 mt-auto border-t-2 border-(--ink) relative overflow-hidden text-white"
    >
      <img
        src={footerBackgroundImage.src}
        alt={footerBackgroundImage.alt}
        aria-hidden="true"
        class="absolute -top-3 left-0 w-full opacity-[0.15] pointer-events-none"
      />
      <div
        class="max-w-7xl mx-auto px-4 grid md:grid-cols-2 gap-12 relative z-10"
      >
        <div>
          <div class="w-16 h-16 text-(--gold) mb-6">
            <Logo class="w-full h-full" />
          </div>
          <h3 class="text-2xl font-bold tracking-wide mb-2">
            {content.footer.title}
          </h3>
          <p class="text-white/80 max-w-sm">{content.site.address}</p>
        </div>
        <div class="md:text-right">
          <p class="font-semibold text-(--gold) tracking-wide mb-4">
            {footerHeading}
          </p>
          <div class="flex flex-col md:items-end gap-2 text-white/85">
            {
              footerLinks.map((item) => (
                <a
                  href={item.href}
                  class="hover:text-white hover:underline decoration-(--gold) underline-offset-4"
                >
                  {item.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
