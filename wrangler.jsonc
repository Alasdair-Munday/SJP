{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sjp-cloudflare-staging",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-18",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/__image*",
      "/api/*",
      "/images/uploads/*",
      "/images/profile-photos/*",
      "/admin",
      "/admin/"
    ]
  },
  "observability": {
    "enabled": true
  }
}
